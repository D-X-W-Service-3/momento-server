# 로컬 개발용 설정 예시. 복사해서 application-local.yml 로 사용하세요.
#   cp application-local.yml.example application-local.yml
# application-local.yml 은 .gitignore 로 커밋 대상에서 제외됩니다.
#
# 아래 datasource 를 주석 해제하지 않으면 H2 인메모리 DB 로 자동 구동됩니다.

spring:
  # --- H2 인메모리 (기본값, 별도 설정 불필요) ---
  h2:
    console:
      enabled: true

  # --- 로컬 MySQL 을 쓰려면 아래 주석 해제 ---
  # datasource:
  #   url: jdbc:mysql://localhost:3306/momento?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
  #   driver-class-name: com.mysql.cj.jdbc.Driver
  #   username: root
  #   password: password

  # ddl-auto 는 여기서 정하지 않는다. 스키마는 Flyway 마이그레이션이 만들고
  # application.yml 이 ddl-auto: validate 로 고정한다. 여기서 create-drop 으로 덮으면
  # 마이그레이션과 엔티티가 어긋나도 로컬에서는 드러나지 않는다.

# 실제 카카오 로그인을 붙일 때 아래 블록의 주석을 해제하고 값을 채우세요.
# 환경변수로 주입해도 됩니다: KAKAO_CLIENT_ID / KAKAO_CLIENT_SECRET
# Redirect URI 는 프론트가 로그인 요청 본문으로 보내므로 서버 설정에 두지 않습니다.
#
# kakao:
#   # 카카오 디벨로퍼스 > 앱 설정 > 앱 키 > REST API 키 (프론트의 JavaScript 키와 다름)
#   client-id: 발급받은-REST-API-키
#   # 카카오 로그인 > 보안 > Client Secret 을 켠 경우에만 채웁니다
#   client-secret: ""
